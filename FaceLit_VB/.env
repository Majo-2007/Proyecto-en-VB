# Copia este archivo a ".env" (mismo directorio del docker-compose.yml)
# y ajusta los valores según tu entorno.

# ─── POSTGRES ──────────────────────────────────────────────
POSTGRES_DB=facelit-db
POSTGRES_USER=facelit_user
POSTGRES_PASSWORD=facelit_password
POSTGRES_PORT=5439

# ─── BACKEND ───────────────────────────────────────────────
BACKEND_PORT=8080
JWT_SECRET=FaceLit2025$ClaveSecretaSuperSegura#SENA@Backend!
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── FRONTEND ──────────────────────────────────────────────
FRONTEND_PORT=8081
# URL que usará el NAVEGADOR para llegar al backend.
# - Pruebas en la misma máquina:      http://localhost:8080
# - Acceso desde otro equipo/intranet: http://IP_DE_LA_VM:8080
FRONTEND_API_URL=http://localhost:8080
